class AssignmentSubmission:
    def __init__(self, student_name:str, student_id:str, assignment_title:str, due_date:str,):
        self.student_name = student_name
        self.student_id = student_id
        self._assignment_title = assignment_title
        self._due_date = due_date
        self.__is_submitted = False
        self.__grade = 0   
        self.__submitted_files:list[str] = []

    def __validate_grade(self,score:float):
        return 0<= score <= 100

    def __check_submission_status(self):
        return self.__is_submitted

    def __is_duplicated(self, filename):
        return filename in self.__submitted_files
            
    def add_file(self,filename):
        if self.__is_duplicated(filename):
            print("File already exists.")
        else: 
            self.__submitted_files.append(filename)
            print(f"{self.student_name} attached '{filename}'. total files:{len(self.__submitted_files)}")

    def remove_file(self, filename):
        if self.__is_submitted == True:
            print(f"{self.student_name} cannot remove files. Assignment already graded")
        elif filename not in self.__submitted_files:
            print("FIle does not exist.")
        elif filename in self.__submitted_files:
            self.__submitted_files.remove(filename)
            self.__is_submitted = False
            print("Successfully removed file.")

    def assign_grade(self, score:float):
        if not self.__submitted_files == []:
            print(f"Grade {score} officially assigned to {self.student_name}")
            self.__is_submitted = True
            self.__grade = score
        else:
            print(f"Cannot grade, no files submitted for {self.student_name}.")

    def get_grade(self):
        return str(self.__grade)

    def view_files(self):
        return str(self.__submitted_files)

    def get_status_report(self):
        status = 0
        if len(self.__submitted_files) <= 0:
            status = "Missing"
        else:
            status = f"Submitted ({len(self.__submitted_files)} files)"
        return f"ID:{self.student_id} | Name:{self.student_name} | Status: {status} | Grade:{self.__grade})"

