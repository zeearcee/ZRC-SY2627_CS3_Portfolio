class CD():
    def __init__(self, announcements):
        self.announcements = announcements

    def printCDstage(self):
        print("\nGood morning students, faculty, and staff. Here are the following announcements.")
    
    def printCD(self):
        print(f"Announcements: {self.announcements}\n")

job = CD("Student Council Elections will be held on April 1st.")
job.printCDstage()
job.printCD()

class CID():
    def __init__(self, announcements, lastquarterun, schoolyear, studentcount):
        self.announcements = announcements
        self.lastquarterun = lastquarterun
        self.schoolyear = schoolyear
        self.studentcount = studentcount
    
    def printCID(self):
        print(f"Announcements: {self.announcements}\n Last Quarter Updates: {self.lastquarterun}\n School Year: {self.schoolyear}\n Student Count: {self.studentcount}\n")

cid = CID("New library hours announced, 7 AM - 5 PM.", "Clearances will start next week.", "2026-2027", 1500)
cid.printCID()

class SSD():
    def __init__(self, announcements, scholarswellbeing, Dormsopperation):
        self.announcements = announcements
        self.scholarswellbeing = scholarswellbeing
        self.Dormsopperation = Dormsopperation
    
    def printSSD(self):
        print(f"Announcements: {self.announcements}\n Scholars Wellbeing: {self.scholarswellbeing}\n Dorms Operation: {self.Dormsopperation}\n")

ssd = SSD("Checking of classrooms will happen at 12:30 PM.", "Counseling services are available for students.", "Dorms will be closed for maintenance on Friday.")
ssd.printSSD()